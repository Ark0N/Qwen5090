# Line endings matter here: bash scripts run inside WSL and break with CRLF.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
# Screenshots: never let the eol rules near them.
*.png binary

# The ZIP root is a product decision: a user who unzips this must see one thing
# to click, plus the README and the licence - nothing else. GitHub builds its
# "Download ZIP" with git archive, which honours export-ignore, so anything
# listed here exists in the repo and in clones but never in the download.
# Verify: git archive --format=tar HEAD | tar -t | sed "s#/.*##" | sort -u
CLAUDE.md      export-ignore
.gitattributes export-ignore
.gitignore     export-ignore
