#!/bin/bash
# Install the DeepSeek Harness AND its TUI profile in the task container and
# point it at the qwen5090 serve; dsh_tui_agent.py runs the TUI in the pane.
# This script is SOURCED into the task's tmux session, so its cd calls leak:
# the starting directory is saved and restored at the end, or the agent runs
# from the install tree instead of the task's working directory.
__DSH_SETUP_PWD="$PWD"
export DEBIAN_FRONTEND=noninteractive
# apt mirrors flake too: a "Hash Sum mismatch" on libstdc++-12-dev killed one
# trial before curl existed, so the nvm retry below never got its chance and
# the task scored as a fail. Retry the whole update+install, dropping the
# partial download between tries.
for __try in 1 2 3 4; do
  apt-get update && apt-get install -y curl ca-certificates python3 make g++ zstd && break
  echo "apt install failed (try $__try)"; apt-get clean; sleep 10
done

# Node via nvm (same pattern as the Claude Code / Qwen Code agents)
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash
source "$HOME/.nvm/nvm.sh"
# `-b`: binary only. Without it a failed download falls back to compiling
# node from source - a 40-minute build that a retry loop happily starts.
# nodejs.org downloads flake ("Provided file to checksum does not exist" was
# one such trial): retry, or dsh never installs and the task fails on a
# missing binary rather than being reported as an install failure.
for __try in 1 2 3 4; do nvm install -b 22 && break; echo "nvm install failed (try $__try)"; sleep 10; done
npm install -g pnpm@11.22.0

export DSH_HOME=/opt/dsh-home
mkdir -p /opt/dsh-runtime "$DSH_HOME/profiles/headless"

# Runtime: the dsh launcher and its plugin tree. The build-script allowlist
# goes in BOTH supported locations (pnpm 10/11 moved it between them), and
# an explicit rebuild backstops both: pnpm silently skipping these builds
# breaks node-pty and the subprocess backend at the first tool call.
cd /opt/dsh-runtime
cat > package.json <<'JSON'
{
  "name": "dsh-runtime",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "node-pty",
      "koffi",
      "protobufjs",
      "@google/genai"
    ]
  }
}
JSON
cat > pnpm-workspace.yaml <<'YAML'
packages:
  - .

onlyBuiltDependencies:
  - "@deepseek-ai/dsh-subprocess-local"
  - node-pty
  - koffi
  - protobufjs
  - "@google/genai"
YAML
pnpm add "@deepseek-ai/dsh@{{ version }}"
pnpm rebuild "@deepseek-ai/dsh-subprocess-local" node-pty koffi protobufjs "@google/genai" || true

# TUI profile: the launcher's own layout (package.json naming the bundles,
# `dsh plugin ... install` fetching the TUI package into the profile's OWN
# node_modules). Not under $DSH_HOME/profiles/node_modules - that is the
# launcher-managed symlink farm, which refuses real directories.
mkdir -p "$DSH_HOME/profiles/dsh-tui"
cd "$DSH_HOME/profiles/dsh-tui"
cat > package.json <<'JSON'
{
  "name": "dsh-profile-dsh-tui",
  "private": true,
  "dependencies": {
    "@deepseek-harness-tui/dsh-tui": "{{ tui_version }}"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-harness-tui/dsh-tui"
      ]
    }
  }
}
JSON
cat > cordis.yml <<'YAML'
[]
YAML
# This file shadows the one `dsh plugin install` would write, so it must carry
# the launcher's own settings too (they are what ~/.dsh/profiles/dsh-tui has):
# `autoInstallPeers: false` above all - dsh-tui declares every @deepseek-ai/dsh-*
# package as a peer, resolved from the runtime at load time, and pnpm 11's
# default of installing peers drags that tree into the profile, where one of
# them wants dsh-scope@^0.1.1, a range no published prerelease satisfies
# (ERR_PNPM_NO_MATCHING_VERSION, the whole install aborted, tui-smoke 2026-08-31).
# `allowBuilds` because pnpm 11 refuses build scripts unless told; the TUI's
# README names these two (neither is needed at runtime) and without it pnpm
# exits non-zero AFTER linking.
cat > pnpm-workspace.yaml <<'YAML'
packages:
  - .

nodeLinker: hoisted
autoInstallPeers: false
minimumReleaseAgeExclude:
  - '@deepseek-harness-tui/dsh-tui@{{ tui_version }}'
allowBuilds:
  '@google/genai': false
  protobufjs: false
YAML
/opt/dsh-runtime/node_modules/.bin/dsh plugin --profile dsh-tui install || true
test -d "$DSH_HOME/profiles/dsh-tui/node_modules/@deepseek-harness-tui/dsh-tui" \
  || { echo "dsh-tui package did not install"; false; }

# The session's composition. dsh 0.1.5-rc.2 REMOVED the agent-presets
# mechanism this used to copy from: there is no
# config/agent-presets/<name>/agent.cordis.yml in the package any more, so the
# regex that swapped the shipped preset's persona row has nothing to match.
# The persona and the tool set are written straight into the profile's patch
# layer instead - which is what a preset file always was, so this is the same
# composition expressed in the mechanism that replaced it.
#
# Same persona text as the headless adapter, so a TUI run still differs from a
# headless one only by the tool set and the TUI itself.
cat > "$DSH_HOME/profiles/dsh-tui/cordis.patch.yml" <<'YAML'
- id: system-prompt
  config:
    personaPrefix: |
      You are a helpful software engineer assistant.{{ persona_rules }}

      When a task needs a long-running process (a server, daemon or watcher) to
      still be running after your turn ends, start it in its own session:
      `setsid -f nohup <command> > <log> 2>&1 < /dev/null &`. A bare `nohup ... &`
      is not enough here - the executor signals the whole process group when a
      turn finishes, so a merely backgrounded child is killed along with it.
      The `-f` matters as well: without it a form like `cd dir && setsid ... &`
      leaves the process inside the shell's process tree, and the tool kills that
      whole tree when the session ends.
      After starting one, confirm it is really listening (curl it, or `ss -ltn`)
      and leave it running.

      When you implement an API, keep to the documented response shape and
      return values in their natural JSON types - a number stays a JSON
      number, never a quoted string, because callers compare it numerically.
      Validate the input: an argument the endpoint cannot meaningfully answer
      for - missing, wrong type, or out of the range the operation is defined
      on - is a 4xx, not a 200 carrying a guess. Two ways this goes
      wrong even when the happy path is right, both measured in review: match a route
      on the PATH, not the raw request-target - a query string does not change the
      path, so /health?x=1 is still /health; and an input that would overflow or raise
      while you compute the answer (a huge integer, a division that cannot be
      represented) is out of range - return 4xx, never let it throw and drop the
      connection, which returns neither a result nor a status.
- id: dsh-tui
  config:
    provider: qwen5090
    model: qwen3.8-27b
    effort: {{ effort }}
YAML
{% if preset == 'minimal' %}
# `minimal`: the shipped presets are gone, so the reduced tool set is now
# expressed as explicit disables - the same list the headless adapter carries.
# `tool-subagent-report` is absent from that list on purpose: 0.1.5 dropped the
# row, and disabling an id that is not in the tree is a silent no-op.
# `tool-result-pruner` (new in 0.1.5) stays enabled - it trims tool results
# rather than granting a capability.
cat >> "$DSH_HOME/profiles/dsh-tui/cordis.patch.yml" <<'YAML'
- id: tool-pwsh
  disabled: true
- id: tool-jobs
  disabled: true
- id: tool-fs
  disabled: true
- id: tool-fs-search
  disabled: true
- id: tool-skill
  disabled: true
- id: tool-subagent-control
  disabled: true
- id: tool-subagent-list-agents
  disabled: true
- id: tool-subagent
  disabled: true
- id: tool-subagent-fork
  disabled: true
- id: tool-workflow
  disabled: true
- id: tool-todo
  disabled: true
- id: tool-goal
  disabled: true
- id: tool-ralph
  disabled: true
- id: tool-web
  disabled: true
YAML
{% endif %}

# The TUI route rides in the same patch file written above: the TUI resolves
# its route from the `dsh-tui` row (not agent-default-model), and a route
# counts only when it names both provider and model. `preset:` is gone with
# the preset mechanism itself.

# Model route: the 5090 box's NInfer serve, canonical settings.
cat > "$DSH_HOME/settings.yaml" <<'YAML'
llm-pi-ai:
  providers:
    qwen5090:
      displayName: Qwen 5090
      apiKeyEnv: QWEN5090_API_KEY
      api: openai-completions
      baseURL: {{ qwen_url }}/v1
      retryPolicy:
        mode: normal
        maxRetries: 10
        backoff:
          initialDelayMs: 1000
          maxDelayMs: 30000
          jitterRatio: 0.1
      compat:
        supportsDeveloperRole: false
        maxTokensField: max_tokens
        supportsReasoningEffort: true
      models:
      - id: qwen3.8-27b
        name: Qwen 5090
        contextWindow: 252928
        # pi-ai's default output cap is 32768; a step spent entirely on reasoning
        # hit it (toolset12 standard/write-compressor, 2026-08-31). TB_DSH_MAX_TOKENS.
        maxTokens: {{ max_tokens }}
        reasoningEfforts:
          'off': none
          low: low
          medium: medium
          xhigh: xhigh
agent-default-model:
  provider: qwen5090
  model: qwen3.8-27b
  reasoningEffort: {{ effort }}
ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
YAML
printf 'QWEN5090_API_KEY=sk-qwen5090-local\n' > "$DSH_HOME/.env"
chmod 600 "$DSH_HOME/.env"

# Launcher shim on PATH; bakes in the nvm node location.
NODE_BIN="$(dirname "$(command -v node)")"
cat > /usr/local/bin/dsh <<SHIM
#!/usr/bin/env bash
export DSH_HOME="\${DSH_HOME:-/opt/dsh-home}"
export PATH="$NODE_BIN:\$PATH"
exec /opt/dsh-runtime/node_modules/.bin/dsh "\$@"
SHIM
chmod +x /usr/local/bin/dsh

# The pane driver. Runs the TUI in the FOREGROUND of the task's tmux pane (so
# it is what the cast records) and a watcher that types the task and, when
# the session log carries turn/end, exits the TUI so this command returns.
cat > /usr/local/bin/dsh-tui-run <<'RUN'
#!/usr/bin/env bash
# usage: dsh-tui-run <task-file>   (must run inside a tmux pane)
TASK_FILE="${1:?task file}"
export DSH_HOME="${DSH_HOME:-/opt/dsh-home}"
PANE=$(tmux display-message -p '#{pane_id}') || { echo "not inside tmux"; exit 1; }
MARK=$(mktemp)           # session logs newer than this are this run's
LOGS="${DSH_RUN_LOGS:-/installed-agent/logs}"
WATCH="${DSH_RUN_LOGS:-/installed-agent}/dsh-tui-watch.log"
(
  t0=$(date +%s)
  until tmux capture-pane -p -t "$PANE" | grep -q '❯'; do
    sleep 0.5
    [ $(( $(date +%s) - t0 )) -gt 180 ] && { echo "composer never appeared"; exit 1; }
  done
  echo "composer after $(( $(date +%s) - t0 ))s"
  sleep 1
  tmux load-buffer -b tbtask "$TASK_FILE" && tmux paste-buffer -p -b tbtask -t "$PANE"
  sleep 1.5
  tmux send-keys -t "$PANE" Enter
  echo "task submitted $(date +%T)"
  t1=$(date +%s); log=""; ends=0; cont=0
  while :; do
    [ -z "$log" ] && log=$(find "$DSH_HOME/sessions" -name session.jsonl.zstd -newer "$MARK" 2>/dev/null | head -1)
    # Copy the (append-only, zstd-framed) log on every poll: a trial that hits
    # Terminal-Bench's agent timeout is killed mid-turn, before the post-exit
    # copy below ever runs, and those are the turns whose record matters most.
    [ -n "$log" ] && { mkdir -p "$LOGS"; cp -f "$log" "$LOGS/session-live.jsonl.zstd" 2>/dev/null || true; }
    n=0; [ -n "$log" ] && n=$(zstd -dcq "$log" 2>/dev/null | grep -c '"type":"turn/end"')
    if [ "$n" -gt "$ends" ]; then
      ends=$n
      last=$(zstd -dcq "$log" 2>/dev/null | grep '"type":"turn/end"' | tail -1)
      echo "turn/end $(date +%T) after $(( $(date +%s) - t1 ))s: $(printf '%s' "$last" | head -c 200)"
      # A turn that ends on max-tokens spent its whole output budget reasoning
      # and took no action (toolset12 standard/write-compressor: 32,768 tokens,
      # all of them thinking). The TUI keeps the session, so continue it in
      # place - up to twice - telling the model to act. `/effort` here is a
      # slider, not a command with an argument, so the effort stays as set.
      if printf '%s' "$last" | grep -q '"kind": *"max-tokens"' && [ "$cont" -lt 2 ]; then
        cont=$((cont+1)); echo "max-tokens: continuation $cont $(date +%T)"
        sleep 2
        tmux send-keys -t "$PANE" -l "Your last step ran out of output budget while reasoning and took no action. Continue from the current state of the working directory: reason briefly, then act with a tool call. Finish the task and end with a short summary."
        sleep 1; tmux send-keys -t "$PANE" Enter
        continue
      fi
      break
    fi
    [ $(( $(date +%s) - t1 )) -gt {{ max_turn_sec }} ] && { echo "watch timeout after {{ max_turn_sec }}s"; break; }
    sleep 3
  done
  sleep 2
  tmux send-keys -t "$PANE" C-c; sleep 1; tmux send-keys -t "$PANE" C-c
) > "$WATCH" 2>&1 &
dsh --profile dsh-tui
rc=$?
# The TUI queries the terminal on exit (device attributes) and quits before the
# reply arrives, so `1;2c` lands on the shell prompt after it. Drain it, or the
# stray bytes prefix the next command Terminal-Bench types into the pane.
read -r -s -t 0.5 -N 64 _junk </dev/tty 2>/dev/null || true
echo; echo "dsh-tui exited rc=$rc"; cat "$WATCH"
# Keep the session log and the watcher log where the adapter collects them,
# plus a process/socket snapshot from right after the TUI exit - a detached
# server that is alive here and refused at test time died in the test phase,
# not with the TUI (toolset12 minimal/fibonacci-server, 2026-08-31).
mkdir -p "$LOGS"
ps -eo pid,ppid,pgid,sid,tty,stat,etimes,cmd > "$LOGS/ps-after-exit.txt" 2>&1
cat /proc/net/tcp /proc/net/tcp6 > "$LOGS/tcp-after-exit.txt" 2>&1
cp -r "$DSH_HOME/sessions" "$LOGS/" 2>/dev/null || true
cp "$WATCH" "$LOGS/" 2>/dev/null || true
exit 0
RUN
chmod +x /usr/local/bin/dsh-tui-run

# Back to the task's working directory before the agent command runs.
cd "$__DSH_SETUP_PWD"

# Readiness probe: composes the TUI profile without booting it, so a broken
# bundle or preset fails HERE (surfaced as INSTALL_FAIL_STATUS), not mid-task.
dsh --profile dsh-tui --dump-config >/dev/null; __dsh_probe_rc=$?

# Persona guard. The readiness probe above cannot catch a persona that failed
# to land: a cordis patch is merged as plain YAML and is never validated
# against the plugin's schema, so an unknown config key survives
# --dump-config and is then STRIPPED by zod when the plugin loads. That is
# exactly how 0.1.5's removal of the `persona` key would have played out - a
# clean install, a green probe, and an agent silently running without its
# rules.
#
# The sentinel is from the setsid block, not the Rules block: `persona_rules`
# is empty for the `baseline` persona, so a Rules grep would fail a run that
# is configured correctly.
#
# Folded into __dsh_probe_rc rather than left as a bare `false`: the final
# line of this script is what Terminal-Bench reads, so a guard that only
# returned non-zero here would be overwritten by it and the install would
# still score as healthy.
if ! dsh --profile dsh-tui --dump-config 2>/dev/null | grep -q 'setsid -f nohup'; then
  echo "PERSONA MISSING from composed dsh-tui profile - refusing to run"
  __dsh_probe_rc=1
fi

# Echo the effort this run was configured with, so the sweep knob is visible in
# the trial's own pane capture rather than only in the launching shell.
grep -n 'reasoningEffort:' "$DSH_HOME/settings.yaml"
# The probe's status must be the LAST status of this sourced script, or
# Terminal-Bench never sees INSTALL_FAIL_STATUS and a broken install scores
# as a plain task failure (measured: nvm flake -> `dsh: No such file` ->
# is_resolved false, failure_mode unset).
command -v dsh >/dev/null && [ "${__dsh_probe_rc:-1}" -eq 0 ]
