#!/bin/bash
# Install the DeepSeek Harness in the task container and point it at the
# qwen5090 serve. Mirrors the layout deepseek-harness.sh produced locally.
# This script is SOURCED into the task's tmux session, so its cd calls leak:
# the starting directory is saved and restored at the end, or the agent runs
# from the install tree instead of the task's working directory.
__DSH_SETUP_PWD="$PWD"
export DEBIAN_FRONTEND=noninteractive
# apt mirrors flake too: a "Hash Sum mismatch" on libstdc++-12-dev killed one
# trial before curl existed, so the nvm retry below never got its chance and
# the task scored as a fail. Retry the whole update+install, dropping the
# partial download between tries.
for __try in 1 2 3 4; do
  apt-get update && apt-get install -y curl ca-certificates python3 make g++ zstd && break
  echo "apt install failed (try $__try)"; apt-get clean; sleep 10
done

# Node via nvm (same pattern as the Claude Code / Qwen Code agents)
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.2/install.sh | bash
source "$HOME/.nvm/nvm.sh"
# `-b`: binary only. Without it a failed download falls back to compiling
# node from source - a 40-minute build that a retry loop happily starts.
# nodejs.org downloads flake ("Provided file to checksum does not exist" was
# one such trial): retry, or dsh never installs and the task fails on a
# missing binary rather than being reported as an install failure.
for __try in 1 2 3 4; do nvm install -b 22 && break; echo "nvm install failed (try $__try)"; sleep 10; done
npm install -g pnpm@11.22.0

export DSH_HOME=/opt/dsh-home
mkdir -p /opt/dsh-runtime "$DSH_HOME/profiles/headless"

# Runtime: the dsh launcher and its plugin tree. The build-script allowlist
# goes in BOTH supported locations (pnpm 10/11 moved it between them), and
# an explicit rebuild backstops both: pnpm silently skipping these builds
# breaks node-pty and the subprocess backend at the first tool call.
cd /opt/dsh-runtime
cat > package.json <<'JSON'
{
  "name": "dsh-runtime",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "node-pty",
      "koffi",
      "protobufjs",
      "@google/genai"
    ]
  }
}
JSON
cat > pnpm-workspace.yaml <<'YAML'
packages:
  - .

onlyBuiltDependencies:
  - "@deepseek-ai/dsh-subprocess-local"
  - node-pty
  - koffi
  - protobufjs
  - "@google/genai"
YAML
pnpm add "@deepseek-ai/dsh@{{ version }}"
pnpm rebuild "@deepseek-ai/dsh-subprocess-local" node-pty koffi protobufjs "@google/genai" || true

# Headless profile files only. NO pnpm install under $DSH_HOME/profiles:
# dsh-app-boot manages profiles/node_modules itself as a symlink farm into
# the runtime's store, and refuses real directories there. The bundles ride
# in as dependencies of @deepseek-ai/dsh.
cd "$DSH_HOME/profiles"
cat > headless/package.json <<'JSON'
{
  "name": "dsh-profile-headless",
  "private": true,
  "dependencies": {},
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-headless"
      ]
    }
  }
}
JSON
cat > headless/cordis.yml <<'YAML'
[]
YAML
cat > headless/cordis.patch.yml <<'YAML'
# Reproduces the harness's `minimal` agent preset for the headless profile.
#
# `personaPrefix`, not `persona`: dsh 0.1.5-rc.2's SystemPrompt.Config is
# {includeHarnessIdentity, includeRuntimeContext, personaPrefix, personaSuffix,
# toolOrder}. The old `persona` key is gone, and zod STRIPS an unknown key
# instead of rejecting it - the persona would vanish with the run still
# passing setup validation, and --dump-config would still show the key,
# because the composition layer never validates against the plugin schema.
# Prefix rather than suffix because this text replaces dsh's own persona
# wholesale, which is what `persona` used to do.
- id: system-prompt
  config:
    personaPrefix: |
      You are a helpful software engineer assistant.{{ persona_rules }}

      When a task needs a long-running process (a server, daemon or watcher) to
      still be running after your turn ends, start it in its own session:
      `setsid -f nohup <command> > <log> 2>&1 < /dev/null &`. A bare `nohup ... &`
      is not enough here - the executor signals the whole process group when a
      turn finishes, so a merely backgrounded child is killed along with it.
      The `-f` matters as well: without it a form like `cd dir && setsid ... &`
      leaves the process inside the shell's process tree, and the tool kills
      that whole tree when the session ends.
      After starting one, confirm it is really listening (curl it, or `ss -ltn`)
      and leave it running.

      When you implement an API, keep to the documented response shape and
      return values in their natural JSON types - a number stays a JSON
      number, never a quoted string, because callers compare it numerically.
      Validate the input: an argument the endpoint cannot meaningfully answer
      for - missing, wrong type, or out of the range the operation is defined
      on - is a 4xx, not a 200 carrying a guess. Two ways this goes
      wrong even when the happy path is right, both measured in review: match a
      route on the PATH, not the raw request-target - a query string does not
      change the path, so /health?x=1 is still /health; and an input that would
      overflow or raise while you compute the answer (a huge integer, a division
      that cannot be represented) is out of range - return 4xx, never let it
      throw and drop the connection, which returns neither a result nor a status.
- id: tool-pwsh
  disabled: true
- id: tool-jobs
  disabled: true
- id: tool-fs
  disabled: true
- id: tool-fs-search
  disabled: true
- id: tool-skill
  disabled: true
- id: tool-subagent-control
  disabled: true
- id: tool-subagent-list-agents
  disabled: true
- id: tool-subagent
  disabled: true
- id: tool-subagent-fork
  disabled: true
- id: tool-workflow
  disabled: true
- id: tool-todo
  disabled: true
- id: tool-goal
  disabled: true
- id: tool-ralph
  disabled: true
- id: tool-web
  disabled: true
# Two drifts against the list this was written from, both checked on
# 0.1.5-rc.2: `tool-subagent-report` no longer exists (dropped rather than
# disabled - a `disabled:` on an absent id is a silent no-op), and
# `tool-result-pruner` is new. The pruner is left ENABLED: it trims tool
# results rather than giving the agent a capability, so disabling it would
# change context economics rather than the tool set under test.
YAML

# Model route: the 5090 box's NInfer serve, canonical settings.
cat > "$DSH_HOME/settings.yaml" <<'YAML'
llm-pi-ai:
  providers:
    qwen5090:
      displayName: Qwen 5090
      apiKeyEnv: QWEN5090_API_KEY
      api: openai-completions
      baseURL: {{ qwen_url }}/v1
      retryPolicy:
        mode: normal
        maxRetries: 10
        backoff:
          initialDelayMs: 1000
          maxDelayMs: 30000
          jitterRatio: 0.1
      compat:
        supportsDeveloperRole: false
        maxTokensField: max_tokens
        supportsReasoningEffort: true
      models:
      - id: qwen3.8-27b
        name: Qwen 5090
        contextWindow: 252928
        # pi-ai's default output cap is 32768; a step spent entirely on reasoning
        # hit it (toolset12 standard/write-compressor, 2026-08-31). TB_DSH_MAX_TOKENS.
        maxTokens: {{ max_tokens }}
        reasoningEfforts:
          'off': none
          low: low
          medium: medium
          xhigh: xhigh
agent-default-model:
  provider: qwen5090
  model: qwen3.8-27b
  reasoningEffort: {{ effort }}
YAML
printf 'QWEN5090_API_KEY=sk-qwen5090-local\n' > "$DSH_HOME/.env"
chmod 600 "$DSH_HOME/.env"

# Launcher shim on PATH; bakes in the nvm node location.
NODE_BIN="$(dirname "$(command -v node)")"
cat > /usr/local/bin/dsh <<SHIM
#!/usr/bin/env bash
export DSH_HOME="\${DSH_HOME:-/opt/dsh-home}"
export PATH="$NODE_BIN:\$PATH"
exec /opt/dsh-runtime/node_modules/.bin/dsh "\$@"
SHIM
chmod +x /usr/local/bin/dsh

# Headless runner: the one `dsh --profile headless "<task>"` shot, with its
# output kept and two kinds of retry, both measured failure modes:
#  - an EMPTY turn (persona12's sqlite-db-truncate re-run: 4m12s of work, no
#    output, nothing written, exit 0) is re-prompted once;
#  - a turn that ends with reason `max-tokens` (toolset12 standard/
#    write-compressor: 32,768 output tokens, every one of them reasoning, no
#    tool call) is continued at LOW effort - a step that spent its whole budget
#    thinking is better finished at low than not at all - up to twice.
# The headless profile cannot resume a session, so a continuation is a fresh
# session told to inspect the working directory first. Output is judged on
# stdout+stderr together (dsh's README: successful runs keep stderr empty).
# Everything lands in $DSH_RUN_LOGS (default /installed-agent/logs), which the
# adapter copies into the trial's agent-logs/ - the container does not survive.
cat > /usr/local/bin/dsh-headless-run <<'RUN'
#!/usr/bin/env bash
TASK_FILE="${1:?task file}"
export DSH_HOME="${DSH_HOME:-/opt/dsh-home}"
LOGS="${DSH_RUN_LOGS:-/installed-agent/logs}"
mkdir -p "$LOGS"
task="$(cat "$TASK_FILE")"
MARK=$(mktemp)
last_reason() {   # reason.kind of the newest session's last turn/end, or "none"
  # dsh 0.1.5 renamed the session log to `session.v3.jsonl.zstd`; 0.1.1 wrote
  # `session.jsonl.zstd`. Match both - a miss here is silent and expensive: the
  # watcher never sees turn/end, so every trial runs to its timeout instead of
  # ending when the turn does (and the max-tokens continuation never fires).
  local log; log=$(find "$DSH_HOME/sessions" -name 'session*.jsonl.zstd' -newer "$MARK" 2>/dev/null -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
  [ -n "$log" ] || { echo none; return; }
  zstd -dcq "$log" 2>/dev/null | grep '"type":"turn/end"' | tail -1 | grep -oE '"kind": *"[^"]+"' | head -1 | grep -oE '"[^"]+"$' | tr -d '"' || echo none
}
shot=1
dsh --profile headless "$task" 2>&1 | tee "$LOGS/dsh-out-$shot.txt"
rc=${PIPESTATUS[0]}
if [ -z "$(tr -d '[:space:]' < "$LOGS/dsh-out-$shot.txt")" ]; then
  shot=$((shot+1))
  echo "[dsh-headless-run] empty turn (dsh rc=$rc, no output at all) - retrying once"
  dsh --profile headless "You started this task earlier and stopped without a final message. Inspect the current state of the working directory first, then finish the task and end with a short summary of what is in place. The task: $task" 2>&1 | tee "$LOGS/dsh-out-$shot.txt"
fi
cont=0
while [ "$(last_reason)" = "max-tokens" ] && [ "$cont" -lt 2 ]; do
  cont=$((cont+1)); shot=$((shot+1))
  echo "[dsh-headless-run] turn ended on max-tokens (reasoning used the whole output budget) - continuation $cont at low effort"
  [ "$cont" -eq 1 ] && cp "$DSH_HOME/settings.yaml" "$LOGS/settings.yaml.orig" && sed -i 's/^\(\s*reasoningEffort:\).*/\1 low/' "$DSH_HOME/settings.yaml"
  MARK=$(mktemp)
  dsh --profile headless "A previous attempt at this task ran out of output budget while reasoning and took no action. Inspect the working directory to see what already exists, then finish the task: reason briefly, act with concrete tool calls, and end with a short summary. The task: $task" 2>&1 | tee "$LOGS/dsh-out-$shot.txt"
done
[ -f "$LOGS/settings.yaml.orig" ] && cp "$LOGS/settings.yaml.orig" "$DSH_HOME/settings.yaml"
cp -r "$DSH_HOME/sessions" "$LOGS/" 2>/dev/null || true
exit 0
RUN
chmod +x /usr/local/bin/dsh-headless-run

# Back to the task's working directory before the agent command runs.
cd "$__DSH_SETUP_PWD"

# Readiness probe: composes the headless profile, so a broken bundle
# install fails HERE (surfaced as INSTALL_FAIL_STATUS), not mid-task.
dsh --profile headless --help >/dev/null; __dsh_probe_rc=$?

# Persona guard. The readiness probe above cannot catch a persona that failed
# to land: a cordis patch is merged as plain YAML and is never validated
# against the plugin's schema, so an unknown config key survives
# --dump-config and is then STRIPPED by zod when the plugin loads. That is
# exactly how 0.1.5's removal of the `persona` key would have played out - a
# clean install, a green probe, and an agent silently running without its
# rules.
#
# The sentinel is from the setsid block, not the Rules block: `persona_rules`
# is empty for the `baseline` persona, so a Rules grep would fail a run that
# is configured correctly.
#
# Folded into __dsh_probe_rc rather than left as a bare `false`: the final
# line of this script is what Terminal-Bench reads, so a guard that only
# returned non-zero here would be overwritten by it and the install would
# still score as healthy.
if ! dsh --profile headless --dump-config 2>/dev/null | grep -q 'setsid -f nohup'; then
  echo "PERSONA MISSING from composed headless profile - refusing to run"
  __dsh_probe_rc=1
fi

# Echo the effort this run was configured with, so the sweep knob is visible in
# the trial's own pane capture rather than only in the launching shell.
grep -n 'reasoningEffort:' "$DSH_HOME/settings.yaml"
# The probe's status must be the LAST status of this sourced script, or
# Terminal-Bench never sees INSTALL_FAIL_STATUS and a broken install scores
# as a plain task failure (measured: nvm flake -> `dsh: No such file` ->
# is_resolved false, failure_mode unset).
command -v dsh >/dev/null && [ "${__dsh_probe_rc:-1}" -eq 0 ]
